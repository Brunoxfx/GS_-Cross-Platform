{
  "expo": {
    "name": "Orbital Sentinel",
    "slug": "orbital-sentinel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/orbital-sentinel-logo-rocket.png",
    "scheme": "orbitalsentinel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08111F",
        "foregroundImage": "./assets/images/orbital-sentinel-logo-rocket.png",
        "backgroundImage": "./assets/images/orbital-sentinel-logo-rocket.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/orbital-sentinel-logo-rocket.png",
          "resizeMode": "contain",
          "backgroundColor": "#08111F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
